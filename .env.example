# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=rfsuser
POSTGRES_PASSWORD=change-me-strong-password
# Used by backend container (hostname = "db" in docker network)
DATABASE_URL=postgresql://rfsuser:change-me-strong-password@db:5432/ripfarsight

# ─── Redis ────────────────────────────────────────────────
# Hostname = "redis" in docker network
REDIS_URL=redis://redis:6379

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-min-32-chars

# ─── Email (Gmail SMTP) ───────────────────────────────────
GMAIL_ADDRESS=hexalogtech@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# ─── Server / CORS ────────────────────────────────────────
FRONTEND_URL=http://localhost

# ─── Admin Seed User ──────────────────────────────────────
ADMIN_EMAIL=admin@hexalog.in
ADMIN_PASSWORD=Admin@123456
