# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ripfarsight

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# ─── Email (Gmail SMTP) ───────────────────────────────────
GMAIL_ADDRESS=hexalogtech@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# ─── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── File Storage ─────────────────────────────────────────
PAYSLIP_DIR=/var/www/ripfarsight/payslips
UPLOADS_DIR=/var/www/ripfarsight/uploads

# ─── Admin Seed ───────────────────────────────────────────
ADMIN_EMAIL=admin@hexalog.in
ADMIN_PASSWORD=Admin@123456
